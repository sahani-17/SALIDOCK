{
    # Admin API off for security
    admin off
}

# ── Localhost & Production Caddy Configuration ───────────────────────────────
# When DOMAIN_NAME is not set, Caddy defaults to http://localhost (no SSL attempts).
# When DOMAIN_NAME is set (e.g. on Azure VM: DOMAIN_NAME=salidock-v2.salixirax.com),
# Caddy automatically provisions HTTPS for that domain.
{$DOMAIN_NAME:http://localhost}, http://127.0.0.1, :80 {

    # Reverse proxy backend API calls
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Reverse proxy health check
    handle /health {
        reverse_proxy backend:8000
    }

    # Serve all other traffic with frontend
    handle {
        reverse_proxy frontend:80
    }
}
