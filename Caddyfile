{
    # Admin API off for security
    admin off
}

# ── Replace salidock.com with your actual domain ──────────────────────────
# Caddy automatically provisions a free HTTPS certificate via Let's Encrypt
salidock.com, www.salidock.com {

    # Redirect www → non-www
    redir https://salidock.com{uri} permanent

    # Reverse proxy backend API calls
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Reverse proxy health check
    handle /health {
        reverse_proxy backend:8000
    }

    # Serve all other traffic with frontend
    handle {
        reverse_proxy frontend:80
    }
}
