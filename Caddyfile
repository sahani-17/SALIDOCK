{
    # Admin API off for security
    admin off
}

# ── salidock-v2.salixirax.com (Production — Azure VM) ────────────────────
# Caddy automatically provisions a free HTTPS certificate via Let's Encrypt.
http://localhost, salidock-v2.salixirax.com {

    # Reverse proxy backend API calls
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Reverse proxy health check
    handle /health {
        reverse_proxy backend:8000
    }

    # Serve all other traffic with frontend
    handle {
        reverse_proxy frontend:80
    }
}
